---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Vardena.tech | Robotics & Media Partnerships";
const pageDescription = "Get in touch with Vardena.tech for robotics fight commentary, media collaboration, press materials, and hardware features.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		
		<main>
			<section class="contact-section">
				<div class="hud-subtitle">// DIRECT CHANNEL</div>
				<h1>Let's talk robotics.</h1>
				<p class="contact-lead">
					We invite robotics companies, humanoid leagues, event organizers, press teams, and media partners to connect with us.
				</p>

				<div class="contact-grid">
					<!-- Contact Cards -->
					<div class="hud-box contact-card">
						<div class="card-label">EMAIL US</div>
						<h3>Partnerships & Media</h3>
						<p>For footage permissions, event credentials, press announcements, and media collaboration.</p>
						<a href="mailto:HELLO@VARDENA.TECH" class="contact-link email-link">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							<span>HELLO@VARDENA.TECH</span>
						</a>
					</div>

					<div class="hud-box contact-card">
						<div class="card-label">PHONE CALL</div>
						<h3>Direct Line</h3>
						<p>Direct communication for urgent media inquiries, event coordination, and partnership calls.</p>
						<a href="tel:+34613570743" class="contact-link phone-link">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							<span>+34 613 57 07 43</span>
						</a>
					</div>
				</div>

				<!-- Location & Topics -->
				<div class="hud-box info-box">
					<div class="info-header">
						<span class="hud-status">[BASE_LOCATION]</span>
						<h2>Madrid, Spain</h2>
					</div>
					<div class="topics-section">
						<h4>Areas of Interest for Collaboration:</h4>
						<ul class="topics-list">
							<li>
								<span class="bullet"></span>
								<strong>Official Footage Permissions:</strong> Securing licensing and legal approval to showcase and narrate tournament matches.
							</li>
							<li>
								<span class="bullet"></span>
								<strong>Press Materials & Event Info:</strong> Receiving official press kits, team profiles, and tournament schedules.
							</li>
							<li>
								<span class="bullet"></span>
								<strong>Robot Specifications & Updates:</strong> Highlighting technical breakthroughs, joint design, and actuator upgrades.
							</li>
							<li>
								<span class="bullet"></span>
								<strong>International Media Collaboration:</strong> Co-producing high-impact content for global English-speaking audiences.
							</li>
						</ul>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1000px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.hud-subtitle {
		font-family: var(--font-hud);
		font-size: 0.85rem;
		color: var(--accent-cyan);
		letter-spacing: 0.1em;
		margin-bottom: 0.5rem;
	}

	h1 {
		margin-bottom: 0.75rem;
	}

	.contact-lead {
		font-size: 1.15rem;
		max-width: 650px;
		color: var(--text-muted);
		margin-bottom: 3rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.card-label {
		font-family: var(--font-hud);
		font-size: 0.75rem;
		color: var(--accent-magenta);
		letter-spacing: 0.05em;
		margin-bottom: 0.5rem;
	}

	.contact-card h3 {
		font-size: 1.35rem;
		margin-bottom: 0.5rem;
	}

	.contact-card p {
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		border-radius: 4px;
		font-weight: 700;
		font-family: var(--font-hud);
		font-size: 1.05rem;
		letter-spacing: 0.02em;
		transition: all 0.25s ease;
	}

	.email-link {
		background: rgba(0, 240, 255, 0.1);
		border: 1px solid var(--accent-cyan);
		color: var(--accent-cyan);
	}

	.email-link:hover {
		background: rgba(0, 240, 255, 0.2);
		box-shadow: var(--glow-cyan);
	}

	.phone-link {
		background: rgba(255, 0, 127, 0.1);
		border: 1px solid var(--accent-magenta);
		color: var(--accent-magenta);
	}

	.phone-link:hover {
		background: rgba(255, 0, 127, 0.2);
		box-shadow: var(--glow-magenta);
	}

	/* Info Box */
	.info-box {
		margin-top: 2rem;
	}

	.info-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		border-bottom: 1px solid rgba(0, 240, 255, 0.2);
		padding-bottom: 1rem;
		margin-bottom: 1.5rem;
	}

	.info-header h2 {
		margin: 0;
		font-size: 1.5rem;
	}

	.topics-section h4 {
		color: var(--text-main);
		font-size: 1.1rem;
		margin-bottom: 1rem;
	}

	.topics-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.topics-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.bullet {
		display: inline-block;
		width: 6px;
		height: 6px;
		background: var(--accent-cyan);
		margin-top: 0.55rem;
		flex-shrink: 0;
	}

	.topics-list strong {
		color: var(--text-main);
	}

	@media (max-width: 600px) {
		main {
			padding: 2rem 1rem;
		}
		.contact-link {
			font-size: 0.9rem;
			word-break: break-all;
		}
	}
</style>
