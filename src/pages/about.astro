---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About Vardena.tech | Humanoid Robotics & AI Media";
const pageDescription = "Learn about Vardena.tech: bridging cutting-edge humanoid robotics, AI fights, and broad global audiences through arcade-style commentary.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main>
			<section class="about-section">
				<div class="hud-subtitle">// PROJECT MISSION & VISION</div>
				<h1>About Vardena.tech</h1>
				<p class="about-lead">
					Vardena.tech is an independent media initiative and personal brand focused on humanoid robot combat, physical artificial intelligence, and hardware engineering stories.
				</p>

				<div class="hud-box about-card">
					<h2>Our Mission</h2>
					<p>
						Humanoid robotics is advancing at unprecedented speed, moving from laboratory prototypes to competitive arenas and real-world environments. However, traditional media coverage often sits at two extremes: overly complex technical papers or sensationalized clips.
					</p>
					<p>
						Vardena.tech bridges this gap. We craft dynamic, arcade-inspired commentary formats (featuring HUD graphics, torque counters, and energy meters) that capture the excitement of robot fights while maintaining deep respect for the underlying engineering.
					</p>
				</div>

				<div class="about-grid">
					<div class="hud-box pillar-card">
						<div class="pillar-num">01</div>
						<h3>Arcade-Style Presentation</h3>
						<p>
							We bring high-energy visual formats to short-form and long-form video, framing matches with health bars, combo statistics, and structural damage analysis.
						</p>
					</div>

					<div class="hud-box pillar-card">
						<div class="pillar-num">02</div>
						<h3>Accessible Engineering</h3>
						<p>
							We translate complex robotics concepts—such as inverse kinematics, actuator bandwidth, balance controllers, and sensor fusion—into intuitive, engaging explanations.
						</p>
					</div>

					<div class="hud-box pillar-card">
						<div class="pillar-num">03</div>
						<h3>Ethical & Authorized Media</h3>
						<p>
							We prioritize fair use, proper team attribution, and official media licensing with robotics leagues, teams, and tournament organizers.
						</p>
					</div>
				</div>

				<div class="hud-box cta-box">
					<div class="cta-content">
						<h3>Looking to Showcase Your Robotics Brand or League?</h3>
						<p>Explore opportunities for official video permissions, hardware features, and press coverage.</p>
						<a href="/contact" class="btn-primary">Get in Touch</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1000px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.hud-subtitle {
		font-family: var(--font-hud);
		font-size: 0.85rem;
		color: var(--accent-cyan);
		letter-spacing: 0.1em;
		margin-bottom: 0.5rem;
	}

	h1 {
		margin-bottom: 0.75rem;
	}

	.about-lead {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 750px;
		margin-bottom: 2.5rem;
	}

	.about-card {
		margin-bottom: 3rem;
	}

	.about-card h2 {
		color: var(--accent-cyan);
		font-size: 1.6rem;
		margin-bottom: 1rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.75rem;
		margin-bottom: 3rem;
	}

	.pillar-card {
		display: flex;
		flex-direction: column;
	}

	.pillar-num {
		font-family: var(--font-hud);
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--accent-magenta);
		margin-bottom: 0.5rem;
	}

	.pillar-card h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
	}

	.pillar-card p {
		font-size: 0.95rem;
		margin: 0;
	}

	.cta-box {
		background: linear-gradient(135deg, rgba(18, 24, 36, 0.95) 0%, rgba(10, 13, 20, 0.95) 100%);
		border-color: var(--border-hud-active);
		text-align: center;
		padding: 2.5rem;
	}

	.cta-content h3 {
		font-size: 1.4rem;
		margin-bottom: 0.5rem;
	}

	.cta-content p {
		margin-bottom: 1.5rem;
	}

	@media (max-width: 600px) {
		main {
			padding: 2rem 1rem;
		}
		.cta-box {
			padding: 1.5rem;
		}
	}
</style>
