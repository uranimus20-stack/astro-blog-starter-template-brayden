---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-main">
			<div class="footer-brand">
				<a href="/" class="footer-brand-link" aria-label="Vardena.tech — home">
					<img
						src="/brand/vardena-v-primary.svg"
						alt="Vardena.tech"
						class="footer-v-mark"
						width="28"
						height="28"
					/>
					<span class="footer-logo"><span class="cyan">VAR</span>DENA<span class="magenta">.TECH</span></span>
				</a>
				<p class="footer-tagline">Robotics, AI and humanoid robot combat.</p>
			</div>
			<div class="footer-nav">
				<a href="/contact" class="footer-link">Contact</a>
			</div>
		</div>

		<div class="coming-soon-bar" aria-label="Upcoming project sections">
			<span class="hud-label">EXPANSION PIPELINE:</span>
			<span class="coming-soon-tag">Fights [Coming soon]</span>
			<span class="coming-soon-tag">News [Coming soon]</span>
			<span class="coming-soon-tag">3D Printing [Coming soon]</span>
		</div>

		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} Vardena.tech. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: rgba(10, 13, 20, 0.95);
		border-top: 1px solid rgba(0, 240, 255, 0.15);
		padding: 3rem 1.5rem 1.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.footer-main {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.footer-logo {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-main);
		letter-spacing: 0.05em;
	}

	.footer-brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	.footer-v-mark {
		display: block;
		height: 28px;
		width: auto;
		flex-shrink: 0;
	}

	.cyan { color: var(--accent-cyan); }
	.magenta { color: var(--accent-magenta); }

	.footer-tagline {
		margin: 0.25rem 0 0 0;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.footer-nav {
		display: flex;
		gap: 1rem;
	}

	.footer-link {
		color: var(--text-main);
		font-weight: 600;
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--border-hud);
		border-radius: 4px;
		transition: all 0.2s ease;
	}

	.footer-link:hover {
		border-color: var(--accent-cyan);
		box-shadow: var(--glow-cyan);
	}

	.coming-soon-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 0.85rem 1.2rem;
		background: rgba(18, 24, 36, 0.6);
		border: 1px dashed rgba(0, 240, 255, 0.2);
		font-family: var(--font-hud);
		font-size: 0.8rem;
	}

	.hud-label {
		color: var(--accent-cyan);
		font-weight: 700;
	}

	.coming-soon-tag {
		color: var(--text-dim);
		background: rgba(255, 255, 255, 0.03);
		padding: 0.2rem 0.5rem;
		border-radius: 3px;
	}

	.footer-bottom {
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 1.5rem;
		color: var(--text-dim);
		font-size: 0.85rem;
	}

	.footer-bottom p {
		margin: 0;
		color: var(--text-dim);
	}

	@media (max-width: 600px) {
		.footer-main {
			flex-direction: column;
		}
		.coming-soon-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}
	}
</style>
